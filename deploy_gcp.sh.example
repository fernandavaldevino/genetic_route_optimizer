#!/bin/bash
# Script de Deploy/Atualização Completa no GCP
#
# Este script faz o deploy ou atualização de todos os componentes:
# - API FastAPI no Cloud Run
# - Streamlit na VM do Compute Engine
#
# Sempre usa a versão atual da branch main do GitHub

set -e

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configurações do projeto - EDITE COM SEUS VALORES
PROJECT_ID="seu-project-id-aqui"
REGION="us-central1"
ZONE="us-central1-a"
REPOSITORY="gro-repository"
API_SERVICE_NAME="genetic-route-optimizer-api"
VM_NAME="streamlit-app"
GITHUB_USER="${GITHUB_USER:-seu-usuario-github}"
GITHUB_REPO="genetic_route_optimizer"

# Carregar variáveis do .env local
if [ -f ".env" ]; then
    echo "Carregando variáveis do arquivo .env local..."
    export $(grep -v '^#' .env | xargs)
else
    echo "⚠️  Arquivo .env não encontrado. As chaves precisarão ser configuradas manualmente na VM."
fi

echo -e "${BLUE}=========================================="
echo -e "🚀 Deploy/Atualização GCP"
echo -e "==========================================${NC}"
echo ""
echo "Project ID: $PROJECT_ID"
echo "Region: $REGION"
echo "GitHub: $GITHUB_USER/$GITHUB_REPO"
echo ""

# Verificar se está logado no gcloud
if ! gcloud auth list --filter=status:ACTIVE --format="value(account)" | grep -q "@"; then
    echo -e "${RED}❌ Você não está autenticado no gcloud${NC}"
    echo "Execute: gcloud auth login"
    exit 1
fi

# Configurar projeto
gcloud config set project $PROJECT_ID

echo -e "${YELLOW}=========================================="
echo -e "📦 PARTE 1: Deploy da API no Cloud Run"
echo -e "==========================================${NC}"
echo ""

# Build da imagem Docker da API
echo -e "${BLUE}🔨 Fazendo build da imagem Docker da API...${NC}"
IMAGE_NAME="$REGION-docker.pkg.dev/$PROJECT_ID/$REPOSITORY/$API_SERVICE_NAME:latest"

# Build para plataforma AMD64 (Cloud Run usa x86_64)
docker build --platform linux/amd64 -t $IMAGE_NAME -f Dockerfile .

# Push da imagem para Artifact Registry
echo -e "${BLUE}📤 Enviando imagem para Artifact Registry...${NC}"
docker push $IMAGE_NAME

# Deploy no Cloud Run
echo -e "${BLUE}🚀 Fazendo deploy no Cloud Run...${NC}"
gcloud run deploy $API_SERVICE_NAME \
    --image=$IMAGE_NAME \
    --platform=managed \
    --region=$REGION \
    --allow-unauthenticated \
    --port=8080 \
    --memory=1Gi \
    --cpu=2 \
    --timeout=300 \
    --max-instances=10 \
    --min-instances=0

# Obter URL da API
API_URL=$(gcloud run services describe $API_SERVICE_NAME \
    --region=$REGION \
    --format='value(status.url)')

echo -e "${GREEN}✅ API deployada com sucesso!${NC}"
echo -e "   URL: ${BLUE}$API_URL${NC}"
echo ""

echo -e "${YELLOW}=========================================="
echo -e "🖥️  PARTE 2: Atualização do Streamlit na VM"
echo -e "==========================================${NC}"
echo ""

# Verificar se a VM existe
if ! gcloud compute instances describe $VM_NAME --zone=$ZONE --project=$PROJECT_ID &>/dev/null; then
    echo -e "${RED}❌ VM '$VM_NAME' não encontrada!${NC}"
    echo -e "${YELLOW}Execute primeiro: ./setup_vm_streamlit.sh${NC}"
    exit 1
fi

# Verificar se a VM está rodando
VM_STATUS=$(gcloud compute instances describe $VM_NAME \
    --zone=$ZONE \
    --project=$PROJECT_ID \
    --format='get(status)')

if [ "$VM_STATUS" != "RUNNING" ]; then
    echo -e "${YELLOW}⚠️  VM está $VM_STATUS. Iniciando...${NC}"
    gcloud compute instances start $VM_NAME --zone=$ZONE --project=$PROJECT_ID
    echo "Aguardando VM iniciar..."
    sleep 30
fi

# Atualizar código na VM
echo -e "${BLUE}🔄 Atualizando código do GitHub na VM...${NC}"

gcloud compute ssh $VM_NAME --zone=$ZONE --project=$PROJECT_ID --tunnel-through-iap --ssh-flag="-o StrictHostKeyChecking=no" --command="
set -e

echo '=== Atualizando repositório do GitHub ==='
cd ~/genetic_route_optimizer

# Garantir que estamos na branch main e puxar últimas alterações
git fetch origin
git checkout main
git pull origin main

echo '=== Atualizando arquivo .env com chaves ==='
cat > .env << 'EOF'
# ===== PROVEDORES =====
LLM_PROVIDER=openai

# ===== CONFIGURAÇÃO OPENAI =====
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=\"gpt-3.5-turbo\"
OPENAI_TEMPERATURE=0.7

# ===== CONFIGURAÇÃO OLLAMA (LOCAL) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7

# ===== CONFIGURAÇÃO BOT TELEGRAM =====
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_BOT_USERNAME=${TELEGRAM_BOT_USERNAME}
BOT_NAME=${TELEGRAM_BOT_USERNAME}
EOF

echo '=== Atualizando dependências Python ==='
source venv/bin/activate
pip install --upgrade pip
pip install -r requirements.txt

echo '=== Reiniciando serviço Streamlit ==='
sudo systemctl restart streamlit

echo '=== Verificando status do serviço ==='
sleep 3
sudo systemctl status streamlit --no-pager
"

# Obter IP da VM
VM_IP=$(gcloud compute instances describe $VM_NAME \
    --zone=$ZONE \
    --project=$PROJECT_ID \
    --format='get(networkInterfaces[0].accessConfigs[0].natIP)')

echo -e "${GREEN}✅ Streamlit atualizado com sucesso!${NC}"
echo -e "   URL: ${BLUE}http://$VM_IP:8501${NC}"
echo ""

# Aguardar Streamlit iniciar e verificar status
echo -e "${BLUE}🔍 Verificando se Streamlit está respondendo...${NC}"
sleep 5

# Tentar acessar o Streamlit (timeout de 10 segundos)
if curl -s --max-time 10 "http://$VM_IP:8501" > /dev/null 2>&1; then
    STREAMLIT_STATUS="${GREEN}✅ RODANDO${NC}"
else
    STREAMLIT_STATUS="${YELLOW}⚠️  INICIANDO${NC}"
fi
echo ""

echo -e "${GREEN}=========================================="
echo -e "✅ DEPLOY COMPLETO FINALIZADO!"
echo -e "==========================================${NC}"
echo ""

# Tabela de Recursos Deployados
echo -e "${BLUE}📊 Recursos Deployados:${NC}"
echo ""
printf "┌─────────────────┬──────────────────┬────────────────┬─────────────────────────────────────────────────────────────────┐\n"
printf "│ %-15s │ %-16s │ %-14s │ %-63s │\n" "Componente" "Plataforma" "Status" "URL"
printf "├─────────────────┼──────────────────┼────────────────┼─────────────────────────────────────────────────────────────────┤\n"
printf "│ %-15s │ %-16s │ ${GREEN}%-14s${NC} │ ${BLUE}%-63s${NC} │\n" "API FastAPI" "Cloud Run" "✅ RODANDO" "$API_URL"
printf "├─────────────────┼──────────────────┼────────────────┼─────────────────────────────────────────────────────────────────┤\n"
echo -e "│ Streamlit       │ VM (e2-medium)   │ $STREAMLIT_STATUS │ ${BLUE}http://$VM_IP:8501${NC}                                              │"
printf "└─────────────────┴──────────────────┴────────────────┴─────────────────────────────────────────────────────────────────┘\n"
echo ""

echo -e "${BLUE}📝 Comandos Úteis:${NC}"
echo ""
echo -e "${YELLOW}API (Cloud Run):${NC}"
echo -e "  - Ver logs:     gcloud run services logs read $API_SERVICE_NAME --region=$REGION --limit=50"
echo -e "  - Descrever:    gcloud run services describe $API_SERVICE_NAME --region=$REGION"
echo ""
echo -e "${YELLOW}Streamlit (VM):${NC}"
echo -e "  - Ver logs:     gcloud compute ssh $VM_NAME --zone=$ZONE --tunnel-through-iap --command='sudo journalctl -u streamlit -f'"
echo -e "  - Reiniciar:    gcloud compute ssh $VM_NAME --zone=$ZONE --tunnel-through-iap --command='sudo systemctl restart streamlit'"
echo -e "  - SSH:          gcloud compute ssh $VM_NAME --zone=$ZONE --tunnel-through-iap"
echo -e "  - Parar VM:     gcloud compute instances stop $VM_NAME --zone=$ZONE"
echo -e "  - Iniciar VM:   gcloud compute instances start $VM_NAME --zone=$ZONE"
echo ""
echo -e "${GREEN}🎉 Tudo pronto para uso!${NC}"
echo ""
